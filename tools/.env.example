# Copy to tools/.env (git-ignored) and fill in.
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-instance-main-1234567
# Odoo 19: Preferences > Account Security > New API Key
ODOO_API_KEY=
# Optional: shows the user in `info`; required for the legacy /jsonrpc protocol
ODOO_LOGIN=admin
# auto | json2 | jsonrpc
ODOO_PROTOCOL=auto
